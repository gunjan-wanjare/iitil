# Base URL of the contact-form API (see lib/api.ts). Baked into the client
# bundle at build time — if unset, the contact form (components/reach-us/ContactForm.tsx)
# will throw "NEXT_PUBLIC_API_URL is required." when a visitor submits it.
# Set as a repo/environment variable in CI (see .github/workflows/deploy-prod.yaml).
NEXT_PUBLIC_API_URL=
